# ============================================================
# ARCHIVO: .env.example (Plantilla de Variables de Entorno)
# DESCRIPCIÓN: Plantilla de configuración con valores falsos.
#              Sirve como guía para saber qué variables necesita el
#              proyecto antes de arrancar.
# ============================================================

# --- CREDENCIALES DE POSTGRESQL ---

# Usuario administrador de la base de datos de Odoo
POSTGRES_USER=odoo

# Contraseña del usuario de base de datos.
POSTGRES_PASSWORD=password_ejemplo_db

# Nombre de la base de datos que PostgreSQL creará
POSTGRES_DB=odoo_erp

# --- CREDENCIALES DE ODOO ---

# Contraseña maestra de Odoo (Master Password).
# Se usa para crear, eliminar o restaurar bases de datos desde /web/database/manager.
# NO es la contraseña del usuario admin de la interfaz web.
ODOO_MASTER_PASSWORD=password_ejemplo_master

# Contraseña del usuario administrador de Odoo (login: admin).
# deploy.sh la aplica automáticamente tras inicializar la BD.
# Distinta de ODOO_MASTER_PASSWORD: esta es para entrar a la interfaz web.
ODOO_ADMIN_PASSWORD=password_ejemplo_admin

GH_PAT="ghp_xxxxxxxxxxxx"
GH_RUNNER_TOKEN_ODOO="AXXXXXXXXXXXXXXXXXX"   # caduca en 1h, genera uno justo antes
GH_RUNNER_TOKEN_DB="AXXXXXXXXXXXXXXXXXX"     # caduca en 1h, genera uno justo antes