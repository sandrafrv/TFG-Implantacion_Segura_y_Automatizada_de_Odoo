# =============================================================
# VARIABLES DE ENTORNO — TFG Odoo
# Copia este fichero a .env y rellena los valores reales.
# NUNCA subas el .env real al repositorio.
# =============================================================

# --- Base de datos PostgreSQL ---
POSTGRES_DB=odoo
POSTGRES_USER=odoo
POSTGRES_PASSWORD=cambia_esta_password

# --- Odoo ---
ODOO_DB=odoo
ODOO_URL=http://localhost:8069
ADMIN_USER=admin
ADMIN_PASSWORD=cambia_esta_password

# --- Red MACVLAN (VLAN 30 - DMZ) ---
PARENT_IFACE=eth0
SUBNET=192.168.30.0/24
GATEWAY=192.168.30.1
ODOO_IP=192.168.30.21
POSTGRES_IP=192.168.30.22
HOST_MACVLAN_IP=192.168.30.23

# --- Acceso SSH (VLAN 40 - Administración) ---
# La máquina Admin y DBA están en una VLAN separada de la DMZ
# para evitar movimiento lateral si Odoo se compromete.
ADMIN_IP=192.168.40.11   # Máquina administración (VLAN 40)
DBA_IP=192.168.40.12     # Máquina DBA (VLAN 40)
